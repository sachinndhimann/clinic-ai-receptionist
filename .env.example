# Database
DATABASE_URL=postgresql+psycopg://clinic_user:clinic_pass@localhost:5432/clinic_ai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# WhatsApp (Gupshup example — swap for Meta Cloud API / Twilio as needed)
WHATSAPP_PROVIDER=gupshup
WHATSAPP_API_KEY=
WHATSAPP_APP_NAME=

# Escalation alerts
STAFF_ALERT_WEBHOOK=   # e.g. SMS/push gateway URL for high-urgency escalations
